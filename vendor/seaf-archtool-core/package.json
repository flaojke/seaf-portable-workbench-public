  "scripts": {
    "test:performance": "node --import tsx --test tests/performance/*.test.mts",
    "bench:performance": "node --import tsx scripts/performance/bench.mts",
    "lib": "vue-cli-service build --name test --target lib",
    "prebuild": "npm run plugins:index",
    "build": "vue-cli-service build",
    "backend:build": "export VUE_APP_DOCHUB_MODE=backend && npm run build",
    "plugin:build": "export VUE_APP_DOCHUB_MODE=plugin && npm run build",
    "plugin:publish": "node scripts/plugin-publish.mjs",
    "dev-backend-ui-up": "export VUE_APP_DOCHUB_MODE=backend VUE_APP_DOCHUB_BACKEND_URL=\"http://localhost:3000\" && vue-cli-service serve",
    "dev-backend-bh-up": "export VUE_APP_DOCHUB_BACKEND_PORT=3000 && npx tsx src/backend/main.mjs",
    "backend-up": "npx tsx src/backend/main.mjs",
    "cluster": "export NODE_OPTIONS=\"$NODE_OPTIONS $VUE_APP_DOCHUB_CLUSTER_NODE_PARAMS_MAIN\" && npx tsx $VUE_APP_DOCHUB_CLUSTER_NODE_PARAMS src/backend/cluster.mjs",
    "backend": "export VUE_APP_DOCHUB_MODE=backend && npm run build && npx tsx src/backend/main.mjs",
    "serve": "vue-cli-service serve",
    "plugins:index": "node scripts/index-plugins.mjs",
    "lint": "vue-cli-service lint --no-fix",
    "lint:fix": "vue-cli-service lint",
    "type-check": "tsc -p tsconfig.check.json && tsc -p tsconfig.corridor-tests.json",
    "test": "jest --coverage",
    "postinstall": "node scripts/install-plugins.mjs",
    "smartants-up": "npx tsx src/backend/smartants-main.mjs",
    "smartants-jvm-up": "npx tsx scripts/smartants-jvm-up.ts",
    "clear-cache": "npx tsx src/backend/clear-cache.mjs",
    "backend-build": "echo \"WARNING: This script is DEPRECATED. Use npm run backend:build\" && npm run backend:build",
    "plugin": "echo \"WARNING: This script is DEPRECATED. Use npm run plugin:build\" && npm run plugin:build"
  },
